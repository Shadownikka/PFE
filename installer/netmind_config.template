# NetMind Configuration
# This file is auto-generated by the installer.
# Edit values below to customize your setup.

[server]
# URL of the NetMind web server (for dashboard sync)
url = https://netmind.io

[tool]
# How often to push telemetry to the server (seconds)
push_interval = 5

# How often to scan for new devices (seconds)
scan_interval = 30

[ai]
# Ollama host for the AI agent
ollama_host = http://localhost:11434

# AI model to use
model = llama3.1

[metrics]
# Prometheus metrics exporter port
port = 9090

[api]
# Local REST API port (for website linking)
port = 7070
